{
	"name": "signalfire",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.11.1",
			"onFail": "download"
		}
	},
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write",
		"check": "pnpm typecheck && pnpm lint && pnpm build"
	},
	"dependencies": {
		"react": "19.3.0",
		"react-dom": "19.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"lefthook": "2.2.1",
		"typescript": "7.0.2",
		"vite": "8.3.4"
	}
}
