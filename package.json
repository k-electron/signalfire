{
	"name": "signalfire",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.11.2",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^26.11.1",
			"onFail": "download"
		}
	},
	"scripts": {
		"dev": "pnpm tokens && vite",
		"build": "pnpm tokens && vite build",
		"tokens": "node tools/tokens/generate.mjs",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"lint": "biome check && node tools/layer-boundaries/check-fixtures.mjs && node tools/tokens/generate.mjs --check",
		"format": "biome check --write",
		"test": "PLAYWRIGHT_BROWSERS_PATH=0 vitest run",
		"test:unit": "vitest run --project unit",
		"browsers:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
		"test:e2e": "pnpm build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
		"check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build"
	},
	"dependencies": {
		"@xstate/react": "6.1.0",
		"idb-keyval": "6.3.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"xstate": "5.33.2",
		"zod": "4.6.6"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@fast-check/vitest": "0.5.0",
		"@playwright/test": "1.64.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"@vitest/browser-playwright": "5.0.3",
		"culori": "4.0.2",
		"fast-check": "4.10.2",
		"lefthook": "2.2.1",
		"playwright": "1.64.0",
		"playwright-core": "1.64.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2",
		"vite": "8.3.4",
		"vitest": "5.0.3",
		"wrangler": "4.149.0"
	}
}
